      /* Web Search Icon Styles */
      .web-search-icon {
        opacity: 0.3;
        transition: opacity 0.2s ease;
      }

      .web-search-icon:hover {
        opacity: 0.6;
      }

      .web-search-icon.active {
        opacity: 1;
      }

      /* Completed Section Styling - Always green when saved */
      /* Completed Section Styling - Always green when saved */
      .section-completed a {
        background-color: #28a745 !important;
        border-color: #28a745 !important;
        color: white !important;
      }
      #ai-assistant-column,
      #editor-column {
        transition: all 0.3s ease;
