

<% if flash[:ai_notice] %>
  <div class="alert alert-info py-2 small ai-flash" role="alert">
    <%= flash[:ai_notice] %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% end %>
<div class="card" style="margin-top: 0;">
  <div class="card-header">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">
        <%= @report.portfolio_company&.name || "Company ##{@report.portfolio_company_id}" %> - AI Report Builder
      </h5>
      <div>
        <span class="badge bg-secondary"><%= @report.status&.humanize || 'Draft' %></span>
        <span class="ms-2 text-muted">
          <%= @report.ai_report_sections.where(reviewed: true).count %>/<%= @report.ai_report_sections.count %> reviewed
        </span>
      </div>
    </div>
  </div>

  <div class="card-body p-0">
    <div class="row g-0" style="height: calc(100vh - 200px); overflow: hidden;">

      <!-- LEFT NAV COLUMN -->
      <div class="col-md-3 border-end" style="height: 100%; overflow-y: auto; background: #f8f9fa;">
        <div class="p-3">
          <h6 class="text-muted mb-3">SECTIONS</h6>
          <% @report.ai_report_sections.order(:order_index).each do |section| %>
            <% is_active   = section == @current_section %>
            <% is_reviewed = section.reviewed? %>

            <%= link_to ai_portfolio_report_path(@report, section_id: section.id),
                class: "d-block p-2 mb-1 rounded text-decoration-none #{is_active ? 'bg-primary text-white' : 'bg-white border text-dark'}" do %>
              <small class="d-flex justify-content-between align-items-center">
                <span><%= section.section_type %></span>
                <% if is_reviewed %>
                  <span class="<%= is_active ? 'text-white' : 'text-success' %>"
                        style="font-size: 18px; font-weight: bold;">&#10004;</span>
                <% end %>
              </small>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- MIDDLE EDITOR COLUMN (simplified, stable) -->
      <div class="col-md-5 border-end" style="height: 100%; overflow: hidden;">
        <div class="p-3 d-flex flex-column" style="height: 100%;">

          <!-- Section title -->
          <div class="mb-3">
            <h5 class="mb-0"><%= @current_section.section_type %></h5>
          </div>

          <%= form_with model: [@report, @current_section],
                        url: ai_portfolio_report_ai_report_section_path(@report, @current_section),
                        method: :patch,
                        id: "section-form" do |f| %>

            <%= f.hidden_field :content, id: "content-hidden-field" %>

            <!-- Scrollable HTML "textarea-like" box -->
            <div class="mb-3"
                 style="height: calc(100vh - 350px); max-height: 100%; overflow-y: auto; border: 1px solid #dee2e6;
                        border-radius: 4px; background: #ffffff; padding: 5px 5px;">
              <div id="report-content"
                   contenteditable="true"
                   style="min-height: 100%; white-space: pre-wrap; font-size: 14px;">
                <%= @current_section.content.body.to_s.html_safe %>
              </div>
            </div>

            <!-- Save button (always visible just below editor) -->
            <div>
              <%= f.submit "Save Section", class: "btn btn-primary" %>
            </div>

          <% end %>
        </div>
      </div>

      <!-- RIGHT AI CHAT COLUMN -->
      <div class="col-md-4 d-flex flex-column" style="height: 100%; overflow: hidden;">

        <!-- Chat Header -->
        <div class="p-3 border-bottom" style="background:#f8f9fa; flex-shrink:0;">
          <strong>AI Assistant</strong><br>
          <small class="text-muted">Context: <%= @current_section.section_type %></small>
        </div>

        <!-- Chat Messages -->
        <div id="chat-messages"
             class="flex-grow-1 p-3"
             style="background:#fafafa; overflow-y:auto;">
          <% if @chat_session.ai_chat_messages.any? %>
            <% @chat_session.ai_chat_messages.order(:created_at).each do |message| %>
              <div class="mb-3 <%= message.role == 'user' ? 'text-end' : '' %>">
                <div class="d-inline-block p-2 rounded <%= message.role == 'user' ? 'bg-primary text-white' : 'bg-white border' %>"
                     style="max-width: 90%; text-align: left;">
                  <%= simple_format(message.content) %>
                  <% if message.role == 'assistant' && message.sources.any? %>
                    <div class="small text-muted mt-2 pt-2 border-top">
                      Sources: <%= message.sources.join(', ') %>
                    </div>
                  <% end %>
                  <% if message.role == 'assistant' %>
                    <button class="btn btn-sm btn-success mt-2"
                            onclick="addToReport('<%= j message.content.gsub("'", "\\'") %>')">
                      + Add to Report
                    </button>
                  <% end %>
                </div>
                <div class="small text-muted mt-1"><%= message.created_at.strftime('%H:%M') %></div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-4">
              <p>Hello! I can help you build this report.</p>
              <p>Ask me anything about the portfolio company!</p>
            </div>
          <% end %>
        </div>

        <!-- Chat Input -->
        <div class="p-3 border-top" style="flex-shrink:0;">
          <div class="mb-2">
            <small class="text-muted">Quick actions:</small><br>
            <button class="btn btn-sm btn-outline-secondary mt-1"
                    onclick="sendMessage('What was Q3 revenue?')">
              Q3 revenue?
            </button>
            <button class="btn btn-sm btn-outline-secondary mt-1"
                    onclick="sendMessage('Show key risks')">
              Key risks
            </button>
          </div>
          <div class="input-group input-group-sm">
            <input type="text" id="chat-input" class="form-control" placeholder="Ask about the portfolio...">
            <button class="btn btn-primary" onclick="sendMessage()">Send</button>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>


<script>
  const reportId      = <%= @report.id %>;
  const sectionId     = <%= @current_section.id %>;
  const chatSessionId = <%= @chat_session.id %>;

  document.addEventListener('DOMContentLoaded', function () {
    // Scroll chat to bottom
    const chatMessages = document.getElementById('chat-messages');
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Enter key sends message
    const chatInput = document.getElementById('chat-input');
    if (chatInput) {
      chatInput.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          sendMessage();
        }
      });
    }

    // Copy HTML from contenteditable into hidden field on submit
    const sectionForm = document.getElementById('section-form');
    if (sectionForm) {
      sectionForm.addEventListener('submit', function () {
        const htmlContent = document.getElementById('report-content').innerHTML;
        document.getElementById('content-hidden-field').value = htmlContent;
      });
    }
  });

// Remove flash after 5 seconds
var flash = document.querySelector('.ai-flash');
if (flash) {
  setTimeout(function() {
    flash.remove();
  }, 5000);
}

  async function sendMessage(text) {
    const input   = document.getElementById('chat-input');
    const message = text || (input ? input.value.trim() : '');

    if (!message) return;
    if (input) input.value = '';

    addMessageToUI('user', message);
    addMessageToUI('assistant', 'Thinking...', [], true);

    try {
      const response = await fetch('/ai_portfolio_reports/' + reportId + '/ai_chat_messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message:        message,
          section_id:     sectionId,
          chat_session_id: chatSessionId
        })
      });

      const data = await response.json();
      removeLoadingMessage();

      if (data.success) {
        addMessageToUI('assistant', data.response, data.sources || []);
      } else {
        addMessageToUI('assistant', 'Error: ' + (data.error || 'Something went wrong'));
      }
    } catch (error) {
      console.error(error);
      removeLoadingMessage();
      addMessageToUI('assistant', 'Connection error. Is Python backend running on port 8000?');
    }
  }

  function addMessageToUI(role, content, sources, isLoading) {
    const container  = document.getElementById('chat-messages');
    if (!container) return;

    const time       = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    const sourcesHtml = (sources && sources.length > 0)
      ? '<div class="small text-muted mt-2 pt-2 border-top">Sources: ' + sources.join(', ') + '</div>'
      : '';

    const addBtn = (role === 'assistant' && !isLoading)
      ? '<button class="btn btn-sm btn-success mt-2" onclick="addToReport(\'' +
          content.replace(/'/g, "\\'").replace(/\n/g, ' ') +
        '\')">+ Add to Report</button>'
      : '';

    const loadClass = isLoading ? 'loading-message' : '';
    const bgClass   = (role === 'user') ? 'bg-primary text-white' : 'bg-white border';
    const alignClass = (role === 'user') ? 'text-end' : '';

    const html =
      '<div class="mb-3 ' + alignClass + ' ' + loadClass + '">' +
        '<div class="d-inline-block p-2 rounded ' + bgClass + '" style="max-width: 90%; text-align: left;">' +
          content.replace(/\n/g, '<br>') +
          sourcesHtml +
          addBtn +
        '</div>' +
        '<div class="small text-muted mt-1">' + time + '</div>' +
      '</div>';

    container.insertAdjacentHTML('beforeend', html);
    container.scrollTop = container.scrollHeight;
  }

  function removeLoadingMessage() {
    const el = document.querySelector('.loading-message');
    if (el) el.remove();
  }

  async function addToReport(content) {
    try {
      const response = await fetch('/ai_portfolio_reports/' + reportId + '/ai_report_sections/' + sectionId + '/add_content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content })
      });

      const data = await response.json();
      if (data.success) {
        if (confirm('Content added! Reload to see changes?')) {
          window.location.reload();
        }
      } else {
        alert('Failed to add content');
      }
    } catch (error) {
      console.error(error);
      alert('Error adding content');
    }
  }
</script>

<style>
.ai-flash {
  animation: fadeOut 0.5s ease 4.5s forwards;
}

@keyframes fadeOut {
  to { opacity: 0; }
}

/* Target the content area more specifically */
#report-content .trix-content {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.5 !important;
}

#report-content .trix-content > *:first-child {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

#report-content .trix-content h1,
#report-content .trix-content h2,
#report-content .trix-content h3 {
  margin-top: 0.5rem !important;
  margin-bottom: 0.5rem !important;
  line-height: 1.3 !important;
}

#report-content .trix-content h3:first-child {
  margin-top: 0 !important;
}

#report-content .trix-content p {
  margin-bottom: 0.5rem !important;
}
</style>


