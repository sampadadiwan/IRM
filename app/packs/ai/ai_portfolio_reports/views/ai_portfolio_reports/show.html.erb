

<% if flash[:ai_notice] %>
  <div class="alert alert-info py-2 small ai-flash" role="alert">
    <%= flash[:ai_notice] %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% end %>
<div class="card" style="margin-top: 0;">
  <div class="card-header">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">
        <%= @report.portfolio_company&.name || "Company ##{@report.portfolio_company_id}" %> - AI Report Builder
      </h5>
      <div>
        <span class="badge bg-secondary"><%= @report.status&.humanize || 'Draft' %></span>
        <span class="ms-2 text-muted">
          <%= @report.ai_report_sections.where(reviewed: true).count %>/<%= @report.ai_report_sections.count %> reviewed
        </span>
      </div>
    </div>
  </div>

  <div class="card-body p-0">
    <div class="row g-0" style="height: calc(100vh - 200px); overflow: hidden;">

      <!-- LEFT NAV COLUMN -->
<div class="col-md-3 border-end" style="height: 100%; overflow-y: auto; background: #f8f9fa;">
  <div class="p-3">
    <h6 class="text-muted mb-3">SECTIONS</h6>
    <% @report.ai_report_sections.order(:order_index).each do |section| %>
      <% is_active = section == @current_section %>
      <% is_reviewed = section.reviewed? %>

      <div class="d-flex align-items-center mb-1 position-relative">
        <!-- Web Search Icon Toggle - Only show for eligible sections, but maintain spacing -->
        <span style="min-width: 24px; margin-right: 8px; text-align: center;">
          <% if AiPortfolioReport::WEB_SEARCH_DEFAULT_SECTIONS.include?(section.section_type) %>
            <span class="web-search-icon <%= section.web_search_enabled ? 'active' : '' %>"
                  data-section-id="<%= section.id %>"
                  onclick="toggleWebSearch(event, <%= section.id %>)"
                  title="<%= section.web_search_enabled ? 'Web search enabled' : 'Click to enable web search' %>"
                  style="cursor: pointer; font-size: 16px; user-select: none; display: inline-block;">
              &#127760;
            </span>
          <% end %>
        </span>

        <%= link_to ai_portfolio_report_path(@report, section_id: section.id),
            class: "flex-grow-1 p-2 rounded text-decoration-none #{is_active ? 'bg-primary text-white' : 'bg-white border text-dark'}" do %>
          <small class="d-flex justify-content-between align-items-center">
            <span><%= section.section_type %></span>
            <% if is_reviewed %>
              <span class="<%= is_active ? 'text-white' : 'text-success' %>"
                    style="font-size: 18px; font-weight: bold;">&#10004;</span>
            <% end %>
          </small>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

      <!-- MIDDLE EDITOR COLUMN (simplified, stable) -->
      <!-- MIDDLE EDITOR COLUMN -->
<div class="col-md-5 border-end" style="height: 100%; overflow: hidden;">
  <div class="p-3 d-flex flex-column" style="height: 100%;">

    <!-- Section title -->
    
    <div class="mb-3">
      <h5 class="mb-0"><%= @current_section.section_type %></h5>
      <% if @current_section.web_search_enabled %>
        <small class="text-muted">?? Web search enabled for this section</small>
      <% end %>
    </div>

    <%= form_with model: [@report, @current_section],
                  url: ai_portfolio_report_ai_report_section_path(@report, @current_section),
                  method: :patch,
                  id: "section-form",
                  html: { style: "display: flex; flex-direction: column; flex: 1; min-height: 0;" } do |f| %>

      <%= f.hidden_field :content, id: "content-hidden-field" %>

      <!-- Scrollable content editor - REDUCED HEIGHT -->
      <div class="mb-3"
           style="flex: 1; overflow-y: auto; border: 1px solid #dee2e6;
                  border-radius: 4px; background: #ffffff; padding: 5px 5px; min-height: 0;">
        <div id="report-content"
             contenteditable="true"
             style="min-height: 100%; white-space: pre-wrap; font-size: 14px;">
          <%= @current_section.content_html.to_s.html_safe %>
        </div>
      </div>

      <!-- NEW: AI Refinement Section -->
      <div class="border-top pt-3 mb-3" style="flex-shrink: 0;">
        <label class="form-label small text-muted mb-2">
          ?? Refine with AI
        </label>
         <textarea 
  id="ai-refinement-prompt" 
  class="form-control form-control-sm mb-2" 
  rows="2" 
  placeholder="<%= @current_section.section_type == 'Custom Charts' ? 'e.g., Show customer growth trend or Revenue breakdown by tier' : 'e.g., Add more competitive advantages or Make it more concise' %>"></textarea>
        
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-primary btn-sm" onclick="regenerateWithAI()">
            ? Regenerate with AI
          </button>
          <%= f.submit "Save Section", class: "btn btn-primary btn-sm" %>
        </div>
      </div>

    <% end %>
  </div>
</div>

      <!-- RIGHT AI CHAT COLUMN -->
      <div class="col-md-4 d-flex flex-column" style="height: 100%; overflow: hidden;">

        <!-- Chat Header -->
        <div class="p-3 border-bottom" style="background:#f8f9fa; flex-shrink:0;">
          <strong>AI Assistant</strong><br>
          <small class="text-muted">Context: <%= @current_section.section_type %></small>
        </div>

        <!-- Chat Messages -->
        <div id="chat-messages"
             class="flex-grow-1 p-3"
             style="background:#fafafa; overflow-y:auto;">
          <% if @chat_session.ai_chat_messages.any? %>
            <% @chat_session.ai_chat_messages.order(:created_at).each do |message| %>
              <div class="mb-3 <%= message.role == 'user' ? 'text-end' : '' %>">
                <div class="d-inline-block p-2 rounded <%= message.role == 'user' ? 'bg-primary text-white' : 'bg-white border' %>"
                     style="max-width: 90%; text-align: left;">
                  <%= simple_format(message.content) %>
                  <% if message.role == 'assistant' && message.sources.any? %>
                    <div class="small text-muted mt-2 pt-2 border-top">
                      Sources: <%= message.sources.join(', ') %>
                    </div>
                  <% end %>
                 
                </div>
                <div class="small text-muted mt-1"><%= message.created_at.strftime('%H:%M') %></div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-4">
              <p>Hello! I can help you build this report.</p>
              <p>Ask me anything about the portfolio company!</p>
            </div>
          <% end %>
        </div>

        <!-- Chat Input -->
        <div class="p-3 border-top" style="flex-shrink:0;">
          <div class="mb-2">
            <small class="text-muted">Quick actions:</small><br>
            <button class="btn btn-sm btn-outline-secondary mt-1"
                    onclick="sendMessage('What was Q3 revenue?')">
              Q3 revenue?
            </button>
            <button class="btn btn-sm btn-outline-secondary mt-1"
                    onclick="sendMessage('Show key risks')">
              Key risks
            </button>
          </div>
          <div class="input-group input-group-sm">
            <input type="text" id="chat-input" class="form-control" placeholder="Ask about the portfolio...">
            <button class="btn btn-primary" onclick="sendMessage()">Send</button>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>


<script>
  const reportId      = <%= @report.id %>;
  const sectionId     = <%= @current_section.id %>;
  const chatSessionId = <%= @chat_session.id %>;

  // Add this inside your existing <script> tag
document.addEventListener('DOMContentLoaded', function() {
  renderAllCharts();
});

function renderAllCharts() {
  const chartPlaceholders = document.querySelectorAll('.chart-placeholder');
  
  chartPlaceholders.forEach((placeholder, index) => {
    const chartConfig = placeholder.getAttribute('data-chart-config');
    const chartType = placeholder.getAttribute('data-chart-type') || 'bar';
    
    if (!chartConfig) return;
    
    try {
      const data = JSON.parse(chartConfig);
      
      // Clear placeholder and create canvas
      placeholder.innerHTML = '';
      const canvas = document.createElement('canvas');
      canvas.id = `chart-${index}`;
      placeholder.appendChild(canvas);
      
      // Create the chart
      new Chart(canvas, {
        type: chartType,
        data: data,
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: {
              display: true,
              position: 'top'
            }
          },
          scales: chartType !== 'pie' && chartType !== 'doughnut' ? {
            y: {
              beginAtZero: true
            }
          } : {}
        }
      });
      
      console.log(`Chart ${index} rendered successfully`);
    } catch (error) {
      console.error(`Error rendering chart ${index}:`, error);
      placeholder.innerHTML = `<div style="color: red;">Error rendering chart: ${error.message}</div>`;
    }
  });
}

  document.addEventListener('DOMContentLoaded', function () {
    // Scroll chat to bottom
    const chatMessages = document.getElementById('chat-messages');
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Enter key sends message
    const chatInput = document.getElementById('chat-input');
    if (chatInput) {
      chatInput.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          sendMessage();
        }
      });
    }

    // Copy HTML from contenteditable into hidden field on submit
    const sectionForm = document.getElementById('section-form');
    if (sectionForm) {
      sectionForm.addEventListener('submit', function () {
        const htmlContent = document.getElementById('report-content').innerHTML;
        document.getElementById('content-hidden-field').value = htmlContent;
      });
    }
  });

// Remove flash after 5 seconds
var flash = document.querySelector('.ai-flash');
if (flash) {
  setTimeout(function() {
    flash.remove();
  }, 5000);
}

// Toggle web search for a section
async function toggleWebSearch(event, sectionId) {
  event.preventDefault();
  event.stopPropagation();
  
  const icon = event.target;
  const isEnabled = icon.classList.contains('active');
  
  try {
    const response = await fetch('/ai_portfolio_reports/' + reportId + '/ai_report_sections/' + sectionId + '/toggle_web_search', {
      method: 'PATCH',
      headers: { 
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    });

    const data = await response.json();
    
    if (data.success) {
      // Toggle the active class
      if (data.web_search_enabled) {
        icon.classList.add('active');
        icon.title = 'Web search enabled';
      } else {
        icon.classList.remove('active');
        icon.title = 'Click to enable web search';
      }
    } else {
      alert('Failed to toggle web search');
    }
  } catch (error) {
    console.error(error);
    alert('Error toggling web search');
  }
}
  async function sendMessage(text) {
    const input   = document.getElementById('chat-input');
    const message = text || (input ? input.value.trim() : '');

    if (!message) return;
    if (input) input.value = '';

    addMessageToUI('user', message);
    addMessageToUI('assistant', 'Thinking...', [], true);

    try {
      const response = await fetch('/ai_portfolio_reports/' + reportId + '/ai_chat_messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message:        message,
          section_id:     sectionId,
          chat_session_id: chatSessionId
        })
      });

      const data = await response.json();
      removeLoadingMessage();

      if (data.success) {
        addMessageToUI('assistant', data.response, data.sources || []);
      } else {
        addMessageToUI('assistant', 'Error: ' + (data.error || 'Something went wrong'));
      }
    } catch (error) {
      console.error(error);
      removeLoadingMessage();
      addMessageToUI('assistant', 'Connection error. Is Python backend running on port 8000?');
    }
  }

  function addMessageToUI(role, content, sources, isLoading) {
    const container  = document.getElementById('chat-messages');
    if (!container) return;

    const time       = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    const sourcesHtml = (sources && sources.length > 0)
      ? '<div class="small text-muted mt-2 pt-2 border-top">Sources: ' + sources.join(', ') + '</div>'
      : '';

    const addBtn = '';

    const loadClass = isLoading ? 'loading-message' : '';
    const bgClass   = (role === 'user') ? 'bg-primary text-white' : 'bg-white border';
    const alignClass = (role === 'user') ? 'text-end' : '';

    const html =
      '<div class="mb-3 ' + alignClass + ' ' + loadClass + '">' +
        '<div class="d-inline-block p-2 rounded ' + bgClass + '" style="max-width: 90%; text-align: left;">' +
          content.replace(/\n/g, '<br>') +
          sourcesHtml +
          addBtn +
        '</div>' +
        '<div class="small text-muted mt-1">' + time + '</div>' +
      '</div>';

    container.insertAdjacentHTML('beforeend', html);
    container.scrollTop = container.scrollHeight;
  }

  function removeLoadingMessage() {
    const el = document.querySelector('.loading-message');
    if (el) el.remove();
  }

  async function addToReport(content) {
    try {
      const response = await fetch('/ai_portfolio_reports/' + reportId + '/ai_report_sections/' + sectionId + '/add_content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content })
      });

      const data = await response.json();
      if (data.success) {
        if (confirm('Content added! Reload to see changes?')) {
          window.location.reload();
        }
      } else {
        alert('Failed to add content');
      }
    } catch (error) {
      console.error(error);
      alert('Error adding content');
    }
  }

async function regenerateWithAI() {
  const prompt = document.getElementById('ai-refinement-prompt').value.trim();
  const currentContent = document.getElementById('report-content').innerHTML;
  
  if (!prompt) {
    alert('Please enter a prompt describing how you want to refine the content');
    return;
  }
  
  // Show loading state
  const button = event.target;
  const originalText = button.innerHTML;
  button.disabled = true;
  button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating...';
  
  try {
    const response = await fetch('/ai_portfolio_reports/' + reportId + '/ai_report_sections/' + sectionId + '/regenerate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        prompt: prompt,
        current_content: currentContent,
        section_type: '<%= @current_section.section_type %>'
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      // Update the content area with new content
      document.getElementById('report-content').innerHTML = data.content;
      
      // Clear the prompt
      document.getElementById('ai-refinement-prompt').value = '';

      renderAllCharts();
      
      // Show success message
      //alert('Content regenerated! Review and click Save Section to keep changes.');
    } else {
      alert('Error: ' + (data.error || 'Failed to regenerate content'));
    }
  } catch (error) {
    console.error(error);
    alert('Connection error. Is Python backend running on port 8000?');
  } finally {
    // Restore button state
    button.disabled = false;
    button.innerHTML = originalText;
  }
}  
</script>

<style>
.ai-flash {
  animation: fadeOut 0.5s ease 4.5s forwards;
}

@keyframes fadeOut {
  to { opacity: 0; }
}

/* Target the content area more specifically */
#report-content .trix-content {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.5 !important;
}

/* Make placeholder text darker */
#ai-refinement-prompt::placeholder {
  color: #7c8fac !important;
  opacity: 1 !important;
}

#report-content .trix-content > *:first-child {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

#report-content .trix-content h1,
#report-content .trix-content h2,
#report-content .trix-content h3 {
  margin-top: 0.5rem !important;
  margin-bottom: 0.5rem !important;
  line-height: 1.3 !important;
}

#report-content .trix-content h3:first-child {
  margin-top: 0 !important;
}

#report-content .trix-content p {
  margin-bottom: 0.5rem !important;
}

/* Web Search Icon Styles */
.web-search-icon {
  opacity: 0.3;
  transition: opacity 0.2s ease;
}

.web-search-icon:hover {
  opacity: 0.6;
}

.web-search-icon.active {
  opacity: 1;
}

/* Completed Section Styling - Always green when saved */
/* Completed Section Styling - Always green when saved */
.section-completed a {
  background-color: #28a745 !important;
  border-color: #28a745 !important;
  color: white !important;
}

/* Selected but not completed - Blue (default behavior, no change needed) */
</style>


